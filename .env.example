# Clave secreta de Django (en producción generar con script seguro)
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria-en-produccion

# Modo depuración (False en producción)
DEBUG=False

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Base de Datos PostgreSQL
DB_NAME=avisos_db
DB_USER=avisos_user
DB_PASSWORD=avisos_pass2026_segura
DB_HOST=db
DB_PORT=5432

# Orígenes CORS permitidos
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
